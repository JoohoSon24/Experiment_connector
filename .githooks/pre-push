#!/bin/sh
# Deny origin, alternate destinations, deletions and non-main updates.
if [ "$1" != festgen ]; then
    echo 'Push denied: only festgen/main is authorized.' >&2
    exit 1
fi
case "$2" in
    git@github.com:JoohoSon24/FestGen.git|git@github-FestGen:JoohoSon24/FestGen.git) ;;
    *) echo 'Push denied: unexpected repository URL.' >&2; exit 1 ;;
esac
while read local_ref local_oid remote_ref remote_oid; do
    if [ "$remote_ref" != refs/heads/main ] || [ "$local_oid" = 0000000000000000000000000000000000000000 ]; then
        echo 'Push denied: main updates only; no deletions.' >&2
        exit 1
    fi
done
